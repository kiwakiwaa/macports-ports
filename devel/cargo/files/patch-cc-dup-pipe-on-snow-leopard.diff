+    #[cfg(target_os = "macos")]
+    fn pipe_writer_cloned(&self) -> Result<Option<File>, Error> {
+        use std::os::unix::io::{AsRawFd, FromRawFd};
+
+        self.pipe_writer
+            .as_ref()
+            .map(|writer| {
+                let descriptor = unsafe { libc::dup(writer.as_raw_fd()) };
+                if descriptor == -1 {
+                    Err(io::Error::last_os_error())
+                } else {
+                    Ok(unsafe { File::from_raw_fd(descriptor) })
+                }
+            })
+            .transpose()
+            .map_err(From::from)
+    }
+
