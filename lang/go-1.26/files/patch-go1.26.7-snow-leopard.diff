+static pthread_key_t snow_g_key;
 
+#define snow_g_magic ((void*)0x23581321345589ULL)
+
+static void
+inittls(void)
+{
+	void *x;
+	pthread_key_t tofree[128], k;
+	int i, ntofree;
+
+	/*
+	 * Snow Leopard's amd64 pthread TLS starts at GS:0x60. Reserve the
+	 * key whose value is stored at GS:0x8a0, the layout used by Go 1.4.3.
+	 */
+	ntofree = 0;
+	for (;;) {
+		if (pthread_key_create(&k, nil) != 0) {
+			fprintf(stderr, "runtime/cgo: pthread_key_create failed\n");
+			abort();
+		}
+		pthread_setspecific(k, snow_g_magic);
+		asm volatile("movq %%gs:0x8a0, %0" : "=r"(x));
+		pthread_setspecific(k, nil);
+		if (x == snow_g_magic) {
+			snow_g_key = k;
+			break;
+		}
+		if (ntofree >= nelem(tofree)) {
+			fprintf(stderr, "runtime/cgo: could not reserve Snow Leopard TLS slot\n");
+			abort();
+		}
+		tofree[ntofree++] = k;
+	}
+	for (i = 0; i < ntofree; i++)
+		pthread_key_delete(tofree[i]);
