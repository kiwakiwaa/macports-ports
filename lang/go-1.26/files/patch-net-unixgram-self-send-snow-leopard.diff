+func (c *UnixConn) isSelfUnixgram(addr *UnixAddr) bool {
+	local, ok := c.fd.laddr.(*UnixAddr)
+	return ok && c.fd.sotype == syscall.SOCK_DGRAM && local.Name != "" && local.Name == addr.Name
+}
+
+func snowLeopardUnixgramWriteFD() (*netFD, error) {
+	// Darwin 10 deadlocks in the kernel when an AF_UNIX datagram socket is
+	// both sender and receiver. An unbound sender preserves delivery while
+	// avoiding the recursive socket lock in uipc_send.
+	return socket(context.Background(), "unixgram", syscall.AF_UNIX, syscall.SOCK_DGRAM, 0, false, nil, nil, nil)
 }
 
