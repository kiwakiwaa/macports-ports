startupitem.create  yes
startupitem.executable \
                    ${prefix}/bin/${name}d \
                    --state=${prefix}/var/lib/${name}/${name}d.state \
                    --statedir=${prefix}/var/lib/${name}

build.env-delete    GO111MODULE=off
test.env-delete     GO111MODULE=off
build.env-append    GO111MODULE=on \
                    GOPROXY=off \
                    GOSUMDB=off
test.env-append     GO111MODULE=on \
                    GOPROXY=off \
                    GOSUMDB=off

build.pre_args-append \
    -trimpath \
    -ldflags \" \
        -X tailscale.com/version.longStamp=${version}    \
        -X tailscale.com/version.shortStamp=${version}   \
        -X tailscale.com/version.gitCommitStamp=non-git  \
    \"

build.args-append   -o _build ./cmd/${name} ./cmd/${name}d

post-extract {
    file mkdir ${worksrcpath}/_build

    # Retain module-mode language semantics while resolving every dependency
    # to its checksummed MacPorts distfile tree.
    set gomod [open ${worksrcpath}/go.mod a]
    foreach vendor ${go.vendors_internal} {
        lassign ${vendor} _ package _ _ _
        if {${package} ne ${go.package}} {
            puts ${gomod} "replace ${package} => ../${package}"
            set vendormod ${gopath}/src/${package}/go.mod
            if {![file exists ${vendormod}]} {
                # Older Go modules predate go.mod. A minimal local manifest
                # keeps their checksummed source usable with offline module mode.
                set modulefile [open ${vendormod} w]
                puts ${modulefile} "module ${package}"
                puts ${modulefile} "go 1.18"
                close ${modulefile}
            }
        }
    }
    close ${gomod}
}

if {${os.platform} eq "darwin" && ${os.major} == 10} {
    post-extract {
        system -W ${worksrcpath} \
            "${patch.cmd} -p1 < ${filespath}/patch-tailscale-snow-leopard.diff"
        system -W ${gopath}/src/github.com/tailscale/certstore \
            "${patch.cmd} -p1 < ${filespath}/patch-certstore-snow-leopard.diff"
        system -W ${gopath}/src/github.com/tailscale/peercred \
            "${patch.cmd} -p1 < ${filespath}/patch-peercred-snow-leopard.diff"
        system -W ${gopath}/src/github.com/prometheus/client_golang \
            "${patch.cmd} -p1 < ${filespath}/patch-prometheus-snow-leopard.diff"
        system -W ${gopath}/src/golang.org/x/net \
            "${patch.cmd} -p1 < ${filespath}/patch-x-net-snow-leopard.diff"
    }
}

destroot {
    xinstall -m 0755 \
        {*}[glob ${worksrcpath}/_build/*] ${destroot}${prefix}/bin/

    xinstall -d ${destroot}${prefix}/share/bash-completion/completions
    system -W ${destroot} \
        ".${prefix}/bin/${name} completion bash > \
         .${prefix}/share/bash-completion/completions/${name}"

    xinstall -d ${destroot}${prefix}/share/fish/vendor_completions.d
    system -W ${destroot} \
        ".${prefix}/bin/${name} completion fish > \
         .${prefix}/share/fish/vendor_completions.d/${name}.fish"

    xinstall -d ${destroot}${prefix}/share/zsh/site-functions
    system -W ${destroot} \
        ".${prefix}/bin/${name} completion zsh > \
         .${prefix}/share/zsh/site-functions/_${name}"
}

destroot.keepdirs   ${destroot}${prefix}/var/lib/${name}

notes "
After launching the Tailscale service for the first time using the steps below (port load), run:

    ${name} up
"

github.livecheck.regex {([0-9.]+)}
