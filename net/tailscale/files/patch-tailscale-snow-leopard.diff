 	"tailscale.com/health"
 	"tailscale.com/net/netmon"
 	"tailscale.com/net/tsaddr"
@@ -106,6 +109,43 @@ func inet(p netip.Prefix) string {
 	return "inet"
 }
 
+func routeDestination(p netip.Prefix) []string {
+	net := netipx.PrefixIPNet(p)
+	nip := net.IP.Mask(net.Mask)
+	if p.Addr().Is6() {
+		// Snow Leopard's route rejects IPv6 CIDR operands. The documented
+		// -prefixlen form also works on newer Darwin and FreeBSD releases.
+		return []string{nip.String(), "-prefixlen", strconv.Itoa(p.Bits())}
+	}
+	return []string{fmt.Sprintf("%v/%d", nip, p.Bits())}
+}
+
+func isSnowLeopard() bool {
+	release, err := unix.Sysctl("kern.osrelease")
+	return err == nil && isSnowLeopardRelease(runtime.GOOS, release)
+}
+
+func isSnowLeopardRelease(goos, release string) bool {
+	return goos == "darwin" && strings.HasPrefix(release, "10.")
+}
+
+func addressAddArgs(tunname string, addr netip.Prefix, snowLeopard bool) []string {
+	if runtime.GOOS == "freebsd" && addr.Addr().Is6() && addr.Bits() == 128 {
+		// FreeBSD rejects tun addresses of the form fc00::1/128 -> fc00::1,
+		// https://bugs.freebsd.org/bugzilla/show_bug.cgi?id=218508
+		// Instead add our whole /48, which works because we use a /48 route.
+		// Full history: https://github.com/tailscale/tailscale/issues/1307
+		tmp := netip.PrefixFrom(addr.Addr(), 48)
+		return []string{"ifconfig", tunname, inet(tmp), tmp.String()}
+	}
+	if snowLeopard && addr.Addr().Is6() {
+		// Snow Leopard leaves an IPv6 point-to-point address tentative when
+		// its peer equals itself. A local prefix lets DAD complete normally.
+		return []string{"ifconfig", tunname, inet(addr), addr.Addr().String(), "prefixlen", strconv.Itoa(addr.Bits())}
+	}
+	return []string{"ifconfig", tunname, inet(addr), addr.String(), addr.Addr().String()}
+}
