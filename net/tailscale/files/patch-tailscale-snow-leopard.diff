+		// FreeBSD rejects tun addresses of the form fc00::1/128 -> fc00::1,
+		// https://bugs.freebsd.org/bugzilla/show_bug.cgi?id=218508
+		// Instead add our whole /48, which works because we use a /48 route.
+		// Full history: https://github.com/tailscale/tailscale/issues/1307
+		tmp := netip.PrefixFrom(addr.Addr(), 48)
+		return []string{"ifconfig", tunname, inet(tmp), tmp.String()}
+	}
+	if snowLeopard && addr.Addr().Is6() {
+		// Snow Leopard leaves an IPv6 point-to-point address tentative when
+		// its peer equals itself. A local prefix lets DAD complete normally.
+		return []string{"ifconfig", tunname, inet(addr), addr.Addr().String(), "prefixlen", strconv.Itoa(addr.Bits())}
+	}
+	return []string{"ifconfig", tunname, inet(addr), addr.String(), addr.Addr().String()}
+}
