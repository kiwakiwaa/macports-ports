+func TestIsSnowLeopard(t *testing.T) {
+	tests := []struct {
+		goos    string
+		release string
+		want    bool
+	}{
+		{"darwin", "10.8.0", true},
+		{"darwin", "11.4.2", false},
+		{"freebsd", "10.8.0", false},
+	}
+	for _, tt := range tests {
+		if got := isSnowLeopardRelease(tt.goos, tt.release); got != tt.want {
+			t.Errorf("isSnowLeopardRelease(%q, %q) = %v, want %v", tt.goos, tt.release, got, tt.want)
+		}
+	}
+}
