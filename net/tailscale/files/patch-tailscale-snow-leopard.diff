 		_, err := unix.GetsockoptTCPConnectionInfo(fd, unix.IPPROTO_TCP, unix.TCP_CONNECTION_INFO)
+		if err == unix.ENOPROTOOPT && isConnectedInetStream(fd) {
+			err = nil
