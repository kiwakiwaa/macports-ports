diff --git a/wgengine/router/osrouter/router_userspace_bsd_test.go b/wgengine/router/osrouter/router_userspace_bsd_test.go
new file mode 100644
index 000000000..1660472be
--- /dev/null
+++ b/wgengine/router/osrouter/router_userspace_bsd_test.go
@@ -0,0 +1,57 @@
+// Copyright (c) Tailscale Inc & contributors
+// SPDX-License-Identifier: BSD-3-Clause
+
+//go:build darwin || freebsd
+
+package osrouter
+
+import (
+	"net/netip"
+	"slices"
+	"testing"
+)
+
+func TestRouteDestination(t *testing.T) {
+	tests := []struct {
+		prefix string
+		want   []string
+	}{
+		{"100.64.0.1/32", []string{"100.64.0.1/32"}},
+		{"100.64.0.1/10", []string{"100.64.0.0/10"}},
+		{"fd7a:115c:a1e0::53/128", []string{"fd7a:115c:a1e0::53", "-prefixlen", "128"}},
+		{"fd7a:115c:a1e0:ffff::1/48", []string{"fd7a:115c:a1e0::", "-prefixlen", "48"}},
+	}
+	for _, tt := range tests {
+		t.Run(tt.prefix, func(t *testing.T) {
+			got := routeDestination(netip.MustParsePrefix(tt.prefix))
+			if !slices.Equal(got, tt.want) {
+				t.Fatalf("routeDestination(%q) = %q, want %q", tt.prefix, got, tt.want)
+			}
+		})
+	}
+}
+
+func TestAddressAddArgs(t *testing.T) {
+	addr := netip.MustParsePrefix("fd7a:115c:a1e0:ab12:4843:cd96:6240:1/128")
+	want := []string{"ifconfig", "utun0", "inet6", addr.Addr().String(), "prefixlen", "128"}
+	if got := addressAddArgs("utun0", addr, true); !slices.Equal(got, want) {
+		t.Fatalf("addressAddArgs Snow Leopard = %q, want %q", got, want)
+	}
+}
+
+func TestIsSnowLeopard(t *testing.T) {
+	tests := []struct {
+		goos    string
+		release string
+		want    bool
+	}{
+		{"darwin", "10.8.0", true},
+		{"darwin", "11.4.2", false},
+		{"freebsd", "10.8.0", false},
+	}
+	for _, tt := range tests {
+		if got := isSnowLeopardRelease(tt.goos, tt.release); got != tt.want {
+			t.Errorf("isSnowLeopardRelease(%q, %q) = %v, want %v", tt.goos, tt.release, got, tt.want)
+		}
+	}
+}
