 // The compiler warns that mach/shared_memory_server.h is deprecated, and to use
 // mach/shared_region.h instead.  But that doesn't define
@@ -25,6 +27,24 @@
 #define SHARED_DATA_REGION_SIZE         0x10000000
 #define SHARED_TEXT_REGION_SIZE         0x10000000
 
+int get_process_start_time(int pid, long long *sec, int *usec)
+{
+    int mib[] = { CTL_KERN, KERN_PROC, KERN_PROC_PID, pid };
+    struct kinfo_proc process;
+    size_t size = sizeof(process);
+
+    if (sysctl(mib, 4, &process, &size, NULL, 0) != 0) {
+        return errno;
+    }
+    if (size == 0) {
+        return ESRCH;
+    }
+
+    *sec = process.kp_proc.p_starttime.tv_sec;
+    *usec = process.kp_proc.p_starttime.tv_usec;
+    return 0;
+}
