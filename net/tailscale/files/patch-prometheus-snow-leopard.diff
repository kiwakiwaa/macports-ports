+    // Snow Leopard predates MACH_TASK_BASIC_INFO. TASK_BASIC_INFO exposes the
+    // same resident and virtual size fields required by this collector.
+    task_basic_info_data_t      info;
+    mach_msg_type_number_t      info_count = TASK_BASIC_INFO_COUNT;
 
     error = task_info(
